# Keitaro Admin API
# Tracker base URL without the /admin_api/v1 suffix, e.g. https://tracker.example.com
KEITARO_URL=
# Admin API key: tracker -> profile -> "API ключи". Sent in the Api-Key header.
KEITARO_API_KEY=

# PostgreSQL. The same variables are read by the postgres container (env_file in compose);
# the app builds the database URL from them, so the password is written once.
POSTGRES_USER=keitaro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=keitaro_wrapper
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
